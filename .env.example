# ScanIQ Community — Environment Configuration Reference
# Duplicate this file to '.env.development' (for local testing) or '.env.production'.
# NOTE: In ScanIQ, all external API keys can be supplied directly at runtime via the UI (Settings / Integrations).
# Environment variables defined here act as default fallbacks during build-time.

# ==============================================================================
# Application Configuration
# ==============================================================================

# Application canonical base URL
VITE_APP_URL=https://scaniq.app

# Analytics & Error Collector Endpoint (Disabled by default)
VITE_ANALYTICS_ENDPOINT=https://analytics.scaniq.app/collect

# Global telemetry toggle switch (Strictly false by default)
VITE_TELEMETRY_ENABLED=false

# ==============================================================================
# External Threat Intelligence Providers (Optional Build-Time Defaults)
# ==============================================================================

# VirusTotal Multi-Engine Reputation API Key
# Docs: https://developers.virustotal.com/reference/overview
VITE_VIRUSTOTAL_KEY=<CONFIGURE_MANUALLY>

# URLScan.io Threat & Sandbox Intelligence API Key
# Docs: https://urlscan.io/docs/api/
VITE_URLSCAN_KEY=<CONFIGURE_MANUALLY>

# AbuseIPDB Crowdsourced IP Reputation API Key
# Docs: https://docs.abuseipdb.com/
VITE_ABUSEIPDB_KEY=<CONFIGURE_MANUALLY>

# Google Safe Browsing Lookup API Key
# Docs: https://developers.google.com/safe-browsing/v4/lookup-api
VITE_SAFEBROWSING_KEY=<CONFIGURE_MANUALLY>

# IPinfo Token for high-volume ASN & Geolocation (Optional)
# Docs: https://ipinfo.io/developers
VITE_IPINFO_TOKEN=<CONFIGURE_MANUALLY>

# URLVoid Domain Reputation API Key (Optional)
# Docs: https://www.urlvoid.com/api/
VITE_URLVOID_KEY=<CONFIGURE_MANUALLY>

# Backend Redirect Proxy URL for safe headless redirect chasing (Optional)
VITE_REDIRECT_PROXY_URL=<CONFIGURE_MANUALLY>
