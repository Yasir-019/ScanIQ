# ScanIQ Production Configuration Example
# Duplicate this file to '.env.development' or '.env.production' and tune values

# Application canonical base URL
VITE_APP_URL=https://scaniq.app

# Secure POST collector endpoint for privacy-friendly telemetry & crash logs
VITE_ANALYTICS_ENDPOINT=https://analytics.scaniq.app/collect

# Global telemetry toggle switch
VITE_TELEMETRY_ENABLED=true
